# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
Tetrage/.utmp/
Tetrage/[Ll]ibrary/
Tetrage/[Tt]emp/
Tetrage/[Oo]bj/
Tetrage/[Bb]uild/
Tetrage/[Bb]uilds/
Tetrage/[Ll]ogs/
Tetrage/[Uu]ser[Ss]ettings/

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
Tetrage/[Mm]emoryCaptures/

# macOS system files
.DS_Store

# Windows system files
Thumbs.db
Desktop.ini

# Recordings can get excessive in size
Tetrage/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# Tetrage/[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
Tetrage/[Aa]ssets/Plugins/Editor/JetBrains*



# Unity local cache directories
Tetrage/[Aa]ssets/AssetStoreCache/

# Gradle cache directory
.gradle/


# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
# Packed Addressables
Tetrage/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
Tetrage/[Aa]ssets/[Ss]treamingAssets/aa.meta
Tetrage/[Aa]ssets/[Ss]treamingAssets/aa/*
